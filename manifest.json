{
    "name": "Binance-Bot",
    "description": "NFT auto-buy bot for binance marketplace",
    "version": "1.5",
    "icons": {"128": "128.png"},
    "manifest_version": 3,
    "content_scripts": [
        {
            "matches": ["*://*.binance.com/*/nft/blindBox/*"],
            "js": ["market.js"],
            "css": ["styles.css"]
        },
        {
            "matches": ["*://*.binance.com/*/nft/goods/*"],
            "js": ["goods.js"],
            "css": ["styles.css"]
        }
    ]
}