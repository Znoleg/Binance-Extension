{
    "name": "Binance-Bot",
    "version": "1.0",
    "manifest_version": 2,
    "content_scripts": [
        {
            "matches": ["https://www.binance.com/ru/nft/blindBox/*"],
            "js": ["market.js"]
        }
    ],
    "browser_action": {
        "default_popup": "popup.html",
        "default_title": "Bot"
    }
}